# One-shot job image: an EF Core migrations bundle, run by deploy.yml as the db-migrate ECS task
# before each API rollout (see docs/adr/0007). Build from the repo root:
#   docker build -f src/FormAI.Infrastructure/Dockerfile.migrator .
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["src/", "src/"]
RUN dotnet restore "src/FormAI.API/FormAI.API.csproj"
RUN dotnet tool install --global dotnet-ef --version "10.0.*"
ENV PATH="$PATH:/root/.dotnet/tools"
# Self-contained, so the final image needs no .NET runtime. Fargate runs x86_64 unless told otherwise.
RUN dotnet ef migrations bundle \
    --project src/FormAI.Infrastructure \
    --startup-project src/FormAI.API \
    --self-contained --target-runtime linux-x64 \
    --output /out/efbundle


FROM mcr.microsoft.com/dotnet/runtime-deps:10.0 AS runtime
WORKDIR /app
COPY --from=build /out/efbundle .
USER $APP_UID
# The task injects MIGRATOR_CONNECTION from Secrets Manager (the form_ai_migrator login).
ENTRYPOINT ["sh", "-c", "exec ./efbundle --connection \"$MIGRATOR_CONNECTION\""]

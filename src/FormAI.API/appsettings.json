{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "ExpiresInMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Ai": {
    "GatewayUrl": "",
    "ApiKey": ""
  },
  "RateLimiting": {
    "Generate": {
      "PermitLimit": 10,
      "WindowMinutes": 60,
      "SegmentsPerWindow": 6
    },
    "ResendVerification": {
      "PermitLimit": 3,
      "WindowMinutes": 15,
      "SegmentsPerWindow": 3
    },
    "Demo": {
      "PermitLimit": 10,
      "WindowMinutes": 15,
      "SegmentsPerWindow": 3
    }
  },
  "RefreshTokenCleanup": {
    "RetentionDays": 10,
    "IntervalHours": 24
  }
}
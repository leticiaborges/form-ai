{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "ExpiresInMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Claude": {
    "Model": "claude-opus-4-5",
    "MaxTokens": 4096
  },
  "RateLimiting": {
    "Generate": {
      "PermitLimit": 10,
      "WindowMinutes": 60,
      "SegmentsPerWindow": 6
    },
    "ResendVerification": {
      "PermitLimit": 3,
      "WindowMinutes": 15,
      "SegmentsPerWindow": 3
    }
  }
}